{
    "name": "ImageNet_LT_ResNeXt50_SADE",
    "n_gpu": 4,
    "arch": {
        "type": "ResNeXt50Model",
        "args": {
            "num_classes": 2,
            "reduce_dimension": true,
            "use_norm": true,
            "returns_feat": true,
            "num_experts": 3
        }
    },
    "data_loader": {
        "type": "S2DataLoader",
        "args": {
            "data_dir": "../data/ImageNet",
            "fold": 1,
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 12
        }
    },
    "optimizer": {
        "type": "SGD",
        "args": {
            "lr": 0.01,
            "weight_decay": 5e-4,
            "momentum": 0.9,
            "nesterov": true
        }
    },
    "add_extra_info": true,
    "loss": {
        "type": "DiverseExpertLoss",
        "args": {
            "tau": 2
        }
    },
    "metrics": [
        "accuracy",
        "classwise_accuracy",
        "macro_f1"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 200,
            "eta_min": 0
        }
    },
    "trainer": {
        "epochs": 200,
        "save_dir": "saved/s2/sade",
        "save_period": 200,
        "verbosity": 2,
        "monitor": "max val_accuracy",
        "tensorboard": false
    }
}